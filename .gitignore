# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Senza la forma senza slash, packages/*/node_modules e apps/*/node_modules
# finiscono nei commit: in un monorepo pnpm sono migliaia di file.
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Regola larga più eccezione esplicita: qualunque file .env resta fuori dal
# repo, tranne il template che contiene solo i nomi delle variabili.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js (anche dentro apps/*)
.next/
out/

# build e cache degli strumenti
.turbo/
dist/
*.log

# supabase (cache locale della CLI, contiene chiavi di sviluppo)
supabase/.branches/
supabase/.temp/

# test end-to-end
test-results/
playwright-report/
blob-report/
.playwright/

# VOCE — variabili d'ambiente
#
# Questo file contiene SOLO i nomi delle variabili. Non scriverci mai un valore
# reale: finirebbe nella cronologia di git e andrebbe ruotato ovunque.
#
# In locale:  copia questo file in apps/web/.env.local e compilalo.
#             cp .env.example apps/web/.env.local
# Su Vercel:  Project Settings -> Environment Variables (stessi nomi).
#
# I valori si ottengono seguendo GUIDE.md. I segreti che nessun servizio ti dà
# li generi tu:
#             openssl rand -hex 32
#
# Se manca una variabile obbligatoria, l'applicazione si rifiuta di partire e
# stampa quale: la validazione sta in apps/web/lib/config/env.ts.

# --- Supabase, parte pubblica -------------------------------------------------
# Le uniche due variabili che possono raggiungere il browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase, parte segreta --------------------------------------------------
# Bypassa la Row Level Security: mai lato client, mai con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -------------------------------------------------------------------
# Usa una chiave dedicata a questo progetto e imposta un limite di spesa
# mensile sull'account: il budget dell'MVP e' ~15 euro.
OPENAI_API_KEY=

# --- Telegram -----------------------------------------------------------------
# Il token lo da' BotFather. Il secret va passato a setWebhook come
# secret_token: senza, chiunque scopra l'URL puo' iniettare segnalazioni false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Twilio (WhatsApp Sandbox) ------------------------------------------------
# TWILIO_WHATSAPP_NUMBER va nel formato whatsapp:+numero
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Segreti interni (openssl rand -hex 32) -----------------------------------
# INTERNAL_KEY  autentica le chiamate server -> server
# CRON_SECRET   autentica i cron (Authorization: Bearer ...)
# IP_HASH_SALT  sale per lo hash degli IP dei firmatari: se lo cambi, gli hash
#               gia' salvati non sono piu' confrontabili
INTERNAL_KEY=
CRON_SECRET=
IP_HASH_SALT=

# --- Applicazione -------------------------------------------------------------
# URL assoluto dell'istanza: http://localhost:3000 in locale, il dominio in
# produzione. Serve al fan-out asincrono dei webhook e ai link inviati ai bot.
APP_URL=

# --- Opzionali ----------------------------------------------------------------
# ACTION_THRESHOLD_CITIZENS  cittadini distinti che fanno scattare la
#                            generazione degli atti. Vuoto = 5.
# SKIP_ENV_VALIDATION        mettilo a 1 solo per typecheck e build in CI,
#                            dove i segreti non ci sono. Mai in produzione.
ACTION_THRESHOLD_CITIZENS=
SKIP_ENV_VALIDATION=

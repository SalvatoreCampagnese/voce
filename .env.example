# VOCE — variabili d'ambiente
#
# Questo file contiene SOLO i nomi delle variabili. Non scriverci mai un valore
# reale: finirebbe nella cronologia di git e andrebbe ruotato ovunque.
#
# In locale:  copia questo file in apps/web/.env.local e compilalo.
#             cp .env.example apps/web/.env.local
# Su Vercel:  Project Settings -> Environment Variables (stessi nomi).
#
# I valori si ottengono seguendo GUIDE.md. I segreti che nessun servizio ti dà
# li generi tu:
#             openssl rand -hex 32
#
# Se manca una variabile obbligatoria, l'applicazione si rifiuta di partire e
# stampa quale: la validazione sta in apps/web/lib/config/env.ts.

# --- Supabase, parte pubblica -------------------------------------------------
# Le uniche due variabili che possono raggiungere il browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase, parte segreta --------------------------------------------------
# Bypassa la Row Level Security: mai lato client, mai con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -------------------------------------------------------------------
# Usa una chiave dedicata a questo progetto e imposta un limite di spesa
# mensile sull'account: il budget dell'MVP e' ~15 euro.
OPENAI_API_KEY=

# --- Telegram -----------------------------------------------------------------
# Il token lo da' BotFather. Il secret va passato a setWebhook come
# secret_token: senza, chiunque scopra l'URL puo' iniettare segnalazioni false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Twilio (WhatsApp Sandbox) ------------------------------------------------
# TWILIO_WHATSAPP_NUMBER va nel formato whatsapp:+numero
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Segreti interni (openssl rand -hex 32) -----------------------------------
# INTERNAL_KEY  autentica le chiamate server -> server
# CRON_SECRET   autentica i cron (Authorization: Bearer ...)
# IP_HASH_SALT  sale per lo hash degli IP dei firmatari: se lo cambi, gli hash
#               gia' salvati non sono piu' confrontabili
INTERNAL_KEY=
CRON_SECRET=
IP_HASH_SALT=

# --- Posta elettronica (opzionale) --------------------------------------------
# Serve a mantenere la promessa «ti scrivo appena diventa un'azione» con chi ha
# segnalato dal sito lasciando un'email. Chi scrive dai bot viene avvisato sul
# suo canale e non ha bisogno di queste variabili.
#
# EMAIL_API_URL  endpoint HTTP compatibile con Resend
#                (https://api.resend.com/emails). Vuoto = canale disattivato.
# EMAIL_API_KEY  chiave del servizio, passata come Authorization: Bearer.
# EMAIL_FROM     mittente verificato, nella forma "VOCE <voce@dominio.it>".
#
# Se restano vuote NON si perde niente: le notifiche via email restano in
# tabella con l'errore «canale email non configurato» e compaiono nel pannello
# di amministrazione, dove una persona le vede.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Applicazione -------------------------------------------------------------
# URL assoluto dell'istanza: http://localhost:3000 in locale, il dominio in
# produzione. Serve al fan-out asincrono dei webhook e ai link inviati ai bot.
APP_URL=

# --- Soglie operative (tutte opzionali) ---------------------------------------
# Lasciarle vuote significa usare i valori tarati in
# apps/web/lib/config/constants.ts. Si cambiano da Vercel senza ricompilare.
# All'avvio l'applicazione controlla che siano coerenti FRA LORO e rifiuta di
# partire se la combinazione non ha senso (vedi lib/config/thresholds.ts).
#
# SIMILARITY_ASSIGN      0-1. Similarita' minima per unire una segnalazione a un
#                        gruppo esistente. Vuoto = 0.55, misurato su dati veri.
# SIMILARITY_NEW         0-1. Similarita' minima per creare un gruppo nuovo.
#                        Deve essere >= SIMILARITY_ASSIGN. Vuoto = 0.60.
# MIN_REPORTS_NEW_CLUSTER  segnalazioni simili per creare un gruppo. Vuoto = 5.
# ACTION_THRESHOLD_CITIZENS  cittadini distinti che fanno scattare la
#                        generazione degli atti. Vuoto = 5.
# RATE_LIMIT_REPORTS_PER_HOUR  segnalazioni per cittadino per canale. Vuoto = 5.
# RATE_LIMIT_WINDOW_MINUTES    ampiezza della finestra. Vuoto = 60.
# CRON_BATCH_SIZE        righe per lotto nei job. Vuoto = 25.
# CRON_TIME_BUDGET_MS    quanto puo' durare un job prima di fermarsi da solo.
#                        Deve stare sotto i 60000 del limite di piattaforma.
#                        Vuoto = 50000.
SIMILARITY_ASSIGN=
SIMILARITY_NEW=
# MIN_REPORTS_NEW_CLUSTER  segnalazioni simili che fanno nascere un gruppo.
#                          Vuoto = 5, tarato su dati veri. Per una demo si
#                          abbassa a 3: i gruppi nascono prima, e la privacy non
#                          cambia (un gruppo resta invisibile finche' non ha
#                          MIN_PUBLIC_CITIZENS cittadini DISTINTI).
MIN_REPORTS_NEW_CLUSTER=3
ACTION_THRESHOLD_CITIZENS=
RATE_LIMIT_REPORTS_PER_HOUR=
RATE_LIMIT_WINDOW_MINUTES=
CRON_BATCH_SIZE=
CRON_TIME_BUDGET_MS=

# --- Soglie di PRIVACY (attenzione) -------------------------------------------
# Queste due esistono anche nel database, nella tabella app_config, ed e' il
# DATABASE a filtrare davvero le viste pubbliche. Cambiarle qui senza cambiarle
# li' non ha alcun effetto sulla privacy: cambia solo cio' che l'applicazione
# crede. /api/health confronta i due valori e risponde 503 se divergono.
#
# Per cambiarle davvero:
#   update app_config set value_int = <n> where key = 'min_public_citizens';
# e poi allinea la variabile qui sotto.
#
# MIN_PUBLIC_CITIZENS  cittadini distinti prima che un gruppo sia pubblico.
#                      Minimo 2: con 1 il gruppo coincide con una persona sola,
#                      che verrebbe cosi' identificata. Vuoto = 3.
# GEO_BLUR_METERS      raggio di arrotondamento delle coordinate pubbliche.
#                      Vuoto = 300. Sotto i 100 m si individua l'isolato.
MIN_PUBLIC_CITIZENS=
GEO_BLUR_METERS=

# --- Accesso dimostrativo al pannello -----------------------------------------
# DEMO_ADMIN_EMAIL  l'indirizzo dell'amministratore di prova. Quando e' valorizzata,
#                   nel piede del sito compare "Accedi all'amministrazione" e la
#                   pagina di accesso mostra un bottone che entra nel pannello
#                   senza codice via email: serve a chi guarda la dimostrazione.
#                   L'account viene creato al primo uso, se non esiste.
#
#                   VUOTA = porta chiusa, bottone assente, azione che rifiuta.
#                   Lasciala vuota in qualunque installazione che raccolga
#                   segnalazioni di cittadini veri: da quel pannello si leggono i
#                   loro racconti in chiaro.
DEMO_ADMIN_EMAIL=demo@voce.local

# --- Sviluppo e CI ------------------------------------------------------------
# SKIP_ENV_VALIDATION  mettilo a 1 solo per typecheck e build in CI, dove i
#                      segreti non ci sono. Mai in produzione.
SKIP_ENV_VALIDATION=
